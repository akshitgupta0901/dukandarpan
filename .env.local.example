# Copy to .env.local and fill in real values. Never commit .env.local.

# Required for everything. Neon Postgres connection string.
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

# Required for rank checks (npm run check, npm run check:all, /api/cron, /api/run-now).
# From https://serpapi.com/dashboard
SERPAPI_API_KEY=your_serpapi_key_here

# Protects /api/cron and /api/run-now. Any random string (e.g. openssl rand -hex 32).
# Optional locally (routes skip the check when unset); set it in production.
CRON_SECRET=your_random_secret_here

# Required only for Telegram alert delivery.
# Bot token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
